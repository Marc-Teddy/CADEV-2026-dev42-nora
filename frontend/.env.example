# NORA frontend — base SQLite locale (aucune donnée en dur dans le code).
# Ce chemin est relatif au dossier prisma/ → fichier frontend/db/custom.db
DATABASE_URL=file:../db/custom.db

# Backend Fastify de l'équipe (PostgreSQL). Avec ces deux lignes, l'interface
# n'utilise plus l'API Next interne : tout passe par le backend via le proxy
# /backend défini dans next.config.ts. Commente-les pour revenir au mode SQLite.
NEXT_PUBLIC_API_URL=/backend/api/v1/app
BACKEND_URL=http://localhost:8080
