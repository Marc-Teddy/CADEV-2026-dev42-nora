# Copier ce fichier en .env puis renseigner les valeurs.
# Ne jamais committer de secret.

# --- Service IA (ai-service) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-coder
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
INTERNAL_API_KEY=
RATE_LIMIT_PER_MINUTE=20
DEFAULT_ANSWER_LANGUAGE=fr
ENVIRONMENT=development

# --- Backend / base de données ---
# À compléter par les responsables backend lors de leur implémentation.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://nora:nora@localhost:5432/nora
DATABASE_POOL_MAX=10
DATABASE_SSL=false
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback
