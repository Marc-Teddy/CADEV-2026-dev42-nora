# Copier ce fichier en .env puis renseigner les valeurs.
# Ne jamais committer de secret.

# --- Service IA (ai-service) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-coder
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
INTERNAL_API_KEY=
RATE_LIMIT_PER_MINUTE=20
DEFAULT_ANSWER_LANGUAGE=fr
ENVIRONMENT=development

# --- Backend / base de données ---
# À compléter par les responsables backend lors de leur implémentation.
